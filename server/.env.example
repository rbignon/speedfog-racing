# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/speedfog_racing

# Twitch OAuth (get from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# App
SECRET_KEY=change-this-to-a-secure-random-string
OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
WEBSOCKET_URL=ws://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Seeds
SEEDS_POOL_DIR=/data/seeds
# Mod DLL appended to every seed pack (locally: ../tools/assets/speedfog_racing.dll)
MOD_DLL_PATH=/opt/speedfog-racing/mod/speedfog_racing.dll
SPEEDFOG_PATH=/path/to/speedfog

# Discord integration (optional, see docs/DISCORD_BOT.md)
# Webhook for race notifications
DISCORD_WEBHOOK_URL=
# Webhook for solo/training live notifications (separate channel)
DISCORD_TRAINING_WEBHOOK_URL=
# Webhook for cheat detections (private admin channel)
DISCORD_ADMIN_WEBHOOK_URL=
# Webhook for speedrun and Set Seed races, and speedrun records while
# DISCORD_RECORDS_WEBHOOK_URL is unset, never pinging @Runner (separate
# channel; the race webhook above when unset)
DISCORD_SPEEDRUN_WEBHOOK_URL=
# Webhook for speedrun records alone (separate channel; the speedrun webhook
# above when unset)
DISCORD_RECORDS_WEBHOOK_URL=
BASE_URL=https://speedfog.racing

# Discord bot (optional, enables scheduled events + runner role)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_RUNNER_ROLE_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=

# events.malenia.win calendar (optional): mirror public scheduled normal races there
MALENIA_API_TOKEN=
MALENIA_API_BASE=https://events.malenia.win/api

# Set Seed (optional, see docs/SPEEDRUN.md)
# Seeds added (scanned) before this instant are not replayable (raise it after each game patch)
# SET_SEED_MIN_SEED_DATE=2026-09-01T00:00:00Z
# The Speedrun boards count runs on seeds added (scanned) from this instant on (never raised)
# SPEEDRUN_BOARD_START_DATE=2026-09-01T00:00:00Z
# A discarded seed among its category's this many best Set Seed seeds keeps its files
# SET_SEED_KEPT_TOP_SEEDS=10
# Seeds a player can protect from the purge at once
# SEED_PROTECTION_LIMIT=3
# Days a discarded seed keeps its files after its last race or session
# SEED_PURGE_GRACE_DAYS=30
# Speedrun draws are refused when a pool has this many AVAILABLE seeds or fewer
# SPEEDRUN_DEFAULT_FLOOR=5
# Hours before an ACTIVE Speedrun solo session is abandoned
# SPEEDRUN_SESSION_TTL_HOURS=24
# Unfinished Speedrun solo sessions in the window that stop a player from starting another (0 disables)
# SPEEDRUN_SOLO_UNFINISHED_LIMIT=3
# SPEEDRUN_SOLO_UNFINISHED_WINDOW_HOURS=24
# Personal bests the Speedrun page's Recent PBs panel lists
# SPEEDRUN_RECENT_RUNS_COUNT=5
# Most practiced seeds panel on the Speedrun tab: seeds listed, and days of history counted
# SPEEDRUN_PRACTICED_SEEDS_COUNT=5
# SPEEDRUN_PRACTICED_SEEDS_DAYS=7

# Race items: each tier (front, middle, back) maps base item keys to a draw weight; an item
# can sit in several tiers, 0 or absent means not drawn, a tier with nothing left grants
# nothing (JSON; this is the default table). A partial table only overrides the tiers it
# names, the others keep their default; an unknown tier or a negative weight stops the
# server from starting, an unknown item key is warned about at startup
# A tier named here replaces that tier whole: an override older than an item never draws it there
# RACE_ITEMS_TIER_WEIGHTS={"front": {"rune_pouch": 1, "banana": 1, "mushroom": 1, "giant": 1}, "middle": {"shield": 1, "mushroom": 1, "red_shell": 1, "hammer": 1, "ink": 1, "vanish": 1, "slow_mo": 1, "camera": 1, "talisman_thief": 1, "toxic_blossom": 1, "junk_weapon": 1}, "back": {"red_shell": 1, "blue_shell": 1, "lightning": 1, "flask_stopper": 1, "toxic_blossom": 1, "star": 1, "vanish": 1, "unseen_foes": 1, "slow_mo": 1, "camera": 1, "talisman_thief": 1, "hammer": 1, "hunter": 1}}
# Damage items: percent of max HP for the banana and red shell, then the shared floor and tail
# (each clamped to 0..100)
# RACE_ITEMS_BANANA_PCT=15
# RACE_ITEMS_RED_SHELL_PCT=40
# RACE_ITEMS_DAMAGE_FLOOR_PCT=20
# RACE_ITEMS_DAMAGE_TAIL_PCT=10
# Hammer: each target's equip load is brought to this percent of its max (70..99 is a
# fat roll; clamped to 0..99)
# RACE_ITEMS_HAMMER_LOAD_PCT=97
# Slow-mo: the target's speed in percent (clamped to 10..100)
# RACE_ITEMS_SLOW_MO_SPEED_PCT=50
# Lightning and Giant: the targets' size in percent (each clamped to 25..300)
# RACE_ITEMS_LIGHTNING_SCALE_PCT=50
# RACE_ITEMS_GIANT_SCALE_PCT=150
# Rank for race items: a runner moves above one it leads by this many seconds of IGT at
# the same point (gap_ms), whatever the layers (0 = IGT alone; a huge value = the
# leaderboard order)
# RACE_ITEMS_IGT_LEAD_S=60

# Sentry (optional, see docs/SENTRY.md)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Server
LOG_LEVEL=INFO
LOG_JSON=false
