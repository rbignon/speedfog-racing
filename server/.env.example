# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost/speedfog_racing

# Twitch OAuth (get from https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=your_client_id
TWITCH_CLIENT_SECRET=your_client_secret
TWITCH_REDIRECT_URI=http://localhost:8000/api/auth/callback

# App
SECRET_KEY=change-this-to-a-secure-random-string
OAUTH_REDIRECT_URL=http://localhost:5173/auth/callback
WEBSOCKET_URL=ws://localhost:8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:8000"]

# Seeds
SEEDS_POOL_DIR=/data/seeds
# Mod DLL appended to every seed pack (locally: ../tools/assets/speedfog_racing.dll)
MOD_DLL_PATH=/opt/speedfog-racing/mod/speedfog_racing.dll
SPEEDFOG_PATH=/path/to/speedfog

# Discord integration (optional, see docs/DISCORD_BOT.md)
# Webhook for race notifications
DISCORD_WEBHOOK_URL=
# Webhook for solo/training live notifications (separate channel)
DISCORD_TRAINING_WEBHOOK_URL=
# Webhook for cheat detections (private admin channel)
DISCORD_ADMIN_WEBHOOK_URL=
# Webhook for speedrun and Set Seed races and speedrun records, never pinging
# @Runner (separate channel; the race webhook above when unset)
DISCORD_SPEEDRUN_WEBHOOK_URL=
BASE_URL=https://speedfog.racing

# Discord bot (optional, enables scheduled events + runner role)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_RUNNER_ROLE_ID=
DISCORD_PUBLIC_KEY=
DISCORD_CHANNEL_ID=

# events.malenia.win calendar (optional): mirror public scheduled races there
MALENIA_API_TOKEN=
MALENIA_API_BASE=https://events.malenia.win/api

# Set Seed (optional, see docs/SPEEDRUN.md)
# Seeds added (scanned) before this instant are not replayable (raise it after each game patch)
# SET_SEED_MIN_SEED_DATE=2026-09-01T00:00:00Z
# The Speedrun boards count runs on seeds added (scanned) from this instant on (never raised)
# SPEEDRUN_BOARD_START_DATE=2026-09-01T00:00:00Z
# A discarded seed among its category's this many best Set Seed seeds keeps its files
# SET_SEED_KEPT_TOP_SEEDS=10
# Seeds a player can protect from the purge at once
# SEED_PROTECTION_LIMIT=3
# Days a discarded seed keeps its files after its last race or session
# SEED_PURGE_GRACE_DAYS=30
# Speedrun draws are refused when a pool has this many AVAILABLE seeds or fewer
# SPEEDRUN_DEFAULT_FLOOR=5
# Hours before an ACTIVE Speedrun solo session is abandoned
# SPEEDRUN_SESSION_TTL_HOURS=24
# Unfinished Speedrun solo sessions in the window that stop a player from starting another (0 disables)
# SPEEDRUN_SOLO_UNFINISHED_LIMIT=3
# SPEEDRUN_SOLO_UNFINISHED_WINDOW_HOURS=24
# Runs the Speedrun page's Recent runs panel lists
# SPEEDRUN_RECENT_RUNS_COUNT=5
# Most practiced seeds panel on the Speedrun tab: seeds listed, and days of history counted
# SPEEDRUN_PRACTICED_SEEDS_COUNT=5
# SPEEDRUN_PRACTICED_SEEDS_DAYS=7

# Sentry (optional, see docs/SENTRY.md)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Server
LOG_LEVEL=INFO
LOG_JSON=false
