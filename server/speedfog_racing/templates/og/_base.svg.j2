<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    {# Circular clip reused by every avatar image, regardless of size. #}
    <clipPath id="avatar-clip" clipPathUnits="objectBoundingBox">
      <circle cx="0.5" cy="0.5" r="0.5"/>
    </clipPath>
  </defs>
  <rect width="1200" height="630" fill="#0f1923"/>

  {# Status-colored route line riding the top edge, echoing the site's cards.
     Children override to restyle it (dashed setup, traveling dot, terminal). #}
  {% block route %}
    <rect x="0" y="0" width="1200" height="6" fill="{{ accent_color }}"/>
  {% endblock %}

  {# Header: wordmark lockup left, status signal right (overridable). #}
  <text x="60" y="99" font-family="Barlow Condensed" font-size="44" letter-spacing="1.8"><tspan font-weight="700" fill="#e8e6e1">SPEEDFOG </tspan><tspan font-weight="600" fill="#c8a44e">RACING</tspan></text>

  {% block badge %}
    <text x="1140" y="99" text-anchor="end" font-family="Spline Sans Mono" font-size="24" font-weight="500" letter-spacing="2.2" fill="{{ accent_color }}">{{ status_label.upper() }}</text>
  {% endblock %}

  {% block body %}{% endblock %}

  {# Meta row (bottom). Default = "{participant_count} · {pool_name}". #}
  {% block meta_left %}
    <text x="60" y="570" font-family="Spline Sans Mono" font-size="26" fill="#96a0ad">{{ participant_count_label }} · <tspan fill="#e8e6e1">{{ pool_name }}</tspan></text>
  {% endblock %}
  {% block meta_right %}{% endblock %}
</svg>
