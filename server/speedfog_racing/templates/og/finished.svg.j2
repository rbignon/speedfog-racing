{% extends "og/_base.svg.j2" %}
{% block body %}
  <text x="60" y="280" font-family="Barlow Condensed" font-size="76" font-weight="600" letter-spacing="2.3" fill="#e8e6e1">{{ race_name.upper() }}</text>
  {% set ax = 60 %}
  {% for p in participants %}
    <image x="{{ ax + loop.index0 * 60 }}" y="340" width="72" height="72" clip-path="url(#avatar-clip)" href="{{ p.avatar_b64 }}"/>
    <circle cx="{{ ax + loop.index0 * 60 + 36 }}" cy="376" r="36" fill="none" stroke="#0f1923" stroke-width="6"/>
  {% endfor %}
  {% if overflow_count %}
    <circle cx="{{ ax + participants|length * 60 + 36 }}" cy="376" r="36" fill="#1c2a3f" stroke="#0f1923" stroke-width="6"/>
    <text x="{{ ax + participants|length * 60 + 36 }}" y="384" text-anchor="middle" font-family="Spline Sans Mono" font-size="22" font-weight="500" fill="#96a0ad">+{{ overflow_count }}</text>
  {% endif %}
  {% if winner %}
    <g transform="translate(720,338)">
      <text x="0" y="52" font-family="Spline Sans Mono" font-size="28" font-weight="600" letter-spacing="1.5" fill="#c8a44e">1st</text>
      <image x="66" y="10" width="60" height="60" clip-path="url(#avatar-clip)" href="{{ winner.avatar_b64 }}"/>
      <text x="140" y="52" font-family="Barlow Condensed" font-size="34" font-weight="600" fill="#e8e6e1">{{ winner.name }}</text>
    </g>
  {% endif %}
{% endblock %}
{% block meta_right %}
  <text x="1140" y="570" text-anchor="end" font-family="Spline Sans Mono" font-size="26" fill="#96a0ad">by <tspan fill="#e8e6e1">{{ organizer_name }}</tspan></text>
{% endblock %}
