# SpeedFog Racing Mod Configuration
# Copy this file to speedfog_racing.toml and fill in your race details

[server]
# Server URL (provided in your race zip)
url = "wss://speedfog-racing.example.com"
# Your unique participant token (provided in your race zip)
mod_token = "YOUR_TOKEN_HERE"
# Race ID (provided in your race zip)
race_id = "YOUR_RACE_ID_HERE"

[overlay]
# Enable/disable the overlay
enabled = true
# Screen corner the overlay is anchored to:
#   "top-left", "top-right", "bottom-left" or "bottom-right"
anchor = "top-right"
# Font size in pixels
font_size = 20
# Leaderboard view the overlay starts on. The leaderboard key cycles it: from
# a layout, hidden, then the other layout; from hidden, centered, then top.
#   "centered": top 3, then you between the three runners ahead and behind,
#               gaps relative to you
#   "top": top 10, gaps relative to the leader
#   "hidden": no leaderboard until you press the leaderboard key
leaderboard_mode = "centered"
# Font path. Leave empty to use the bundled Public Sans font.
# Set to a TTF path (absolute, relative to the DLL, or just a filename to
# search in C:\Windows\Fonts) to override.
# font_path = ""

[keybindings]
# Hotkeys only respond while the game window has focus.
# Key to toggle UI visibility (set to "none" to disable)
toggle_ui = "f9"
# Key to toggle debug section (debug builds only; release builds ignore it)
toggle_debug = "none"
# Key to cycle the leaderboard from its starting view (see leaderboard_mode;
# set to "none" to disable)
toggle_leaderboard = "f10"
