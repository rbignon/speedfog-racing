# Drop into the speedfog.racing server block, BEFORE the catch-all
# `try_files $uri /200.html` location.
#
# Routes known social-media crawlers on /race/<id> to a FastAPI endpoint
# that renders per-race Open Graph meta tags. Humans hit the static SPA
# path unchanged.
location ~ ^/race/([^/]+)/?$ {
    set $race_id $1;
    if ($http_user_agent ~* "(Twitterbot|facebookexternalhit|Discordbot|LinkedInBot|Slackbot|TelegramBot|WhatsApp|Pinterest|redditbot|Googlebot|bingbot)") {
        proxy_pass http://127.0.0.1:8000/api/og/race/$race_id/meta;
        break;
    }
    try_files $uri /200.html;
}
