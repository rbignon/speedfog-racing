# SpeedFog Racing - Production environment
# Copy to /opt/speedfog-racing/server/.env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://speedfog:CHANGEME@localhost/speedfog_racing

# Twitch OAuth (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://racing.speedfog.example/api/auth/callback

# App
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
OAUTH_REDIRECT_URL=https://racing.speedfog.example/auth/callback
WEBSOCKET_URL=wss://racing.speedfog.example
CORS_ORIGINS=["https://racing.speedfog.example"]
BASE_URL=https://racing.speedfog.example

# Seeds
SEEDS_POOL_DIR=/data/SpeedFog/racing/seeds/standard
# Mod DLL appended to every seed pack (installed there by deploy/deploy.sh)
MOD_DLL_PATH=/opt/speedfog-racing/mod/speedfog_racing.dll
# Path to the speedfog repo, enables seed generation
#SPEEDFOG_PATH=

# OG images
#OG_CACHE_DIR=~/.cache/speedfog-racing/og

# Race
#COUNTDOWN_SECONDS=10
# Reject mods older than this release (emergency gate, e.g. a crashing build)
#MIN_MOD_VERSION=

# Site-wide announcement banner (optional). Shown on every web page within
# 15 minutes of a service restart, no frontend deploy needed. Dismissable per
# message. Quote the text: an unquoted " #" starts a comment.
#ANNOUNCEMENT=""
#ANNOUNCEMENT_URL=/help#faq-game-update
# Label of that link, "Read more" by default; keep it to a few words, it
# never wraps
#ANNOUNCEMENT_LINK_TEXT=""

# Discord webhooks (optional)
#DISCORD_WEBHOOK_URL=
#DISCORD_TRAINING_WEBHOOK_URL=
#DISCORD_ADMIN_WEBHOOK_URL=

# Discord bot (optional, enables scheduled events + runner role)
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=
#DISCORD_RUNNER_ROLE_ID=
#DISCORD_PUBLIC_KEY=
#DISCORD_CHANNEL_ID=

# events.malenia.win calendar (optional)
#MALENIA_API_TOKEN=
#MALENIA_API_BASE=https://events.malenia.win/api

# Set Seed (optional, see docs/SPEEDRUN.md)
# Seeds added (scanned) before this instant are not replayable (raise it after each game patch)
# SET_SEED_MIN_SEED_DATE=2026-09-01T00:00:00Z
# A discarded seed among its category's this many best Set Seed seeds keeps its files
# SET_SEED_KEPT_TOP_SEEDS=10
# Seeds a player can protect from the purge at once
# SEED_PROTECTION_LIMIT=3
# Days a discarded seed keeps its files after its last race or session
# SEED_PURGE_GRACE_DAYS=30
# Speedrun draws are refused when a pool has this many AVAILABLE seeds or fewer
# SPEEDRUN_DEFAULT_FLOOR=5
# Hours before an ACTIVE Speedrun solo session is abandoned
# SPEEDRUN_SESSION_TTL_HOURS=24
# Runs the Speedrun page's Recent runs panel lists
# SPEEDRUN_RECENT_RUNS_COUNT=5
# Most practiced seeds panel on the Speedrun tab: seeds listed, and days of history counted
# SPEEDRUN_PRACTICED_SEEDS_COUNT=5
# SPEEDRUN_PRACTICED_SEEDS_DAYS=7

# Logging
LOG_LEVEL=INFO
#LOG_JSON=true

# Garbage collector tuning (deploy/README.md, "Event loop monitor"); 0 keeps
# the interpreter's defaults
#GC_GEN0_THRESHOLD=50000

# Sentry (optional)
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
