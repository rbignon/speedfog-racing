# SpeedFog Racing - Production environment
# Copy to /opt/speedfog-racing/server/.env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://speedfog:CHANGEME@localhost/speedfog_racing

# Twitch OAuth (https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=https://racing.speedfog.example/api/auth/callback

# App
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
OAUTH_REDIRECT_URL=https://racing.speedfog.example/auth/callback
WEBSOCKET_URL=wss://racing.speedfog.example
CORS_ORIGINS=["https://racing.speedfog.example"]
BASE_URL=https://racing.speedfog.example

# Seeds
SEEDS_POOL_DIR=/data/SpeedFog/racing/seeds/standard
# Path to the speedfog repo, enables seed generation
#SPEEDFOG_PATH=

# OG images
#OG_CACHE_DIR=~/.cache/speedfog-racing/og

# Race
#COUNTDOWN_SECONDS=10
# Reject mods older than this release (emergency gate, e.g. a crashing build)
#MIN_MOD_VERSION=

# Discord webhooks (optional)
#DISCORD_WEBHOOK_URL=
#DISCORD_TRAINING_WEBHOOK_URL=

# Discord bot (optional, enables scheduled events + runner role)
#DISCORD_BOT_TOKEN=
#DISCORD_GUILD_ID=
#DISCORD_RUNNER_ROLE_ID=
#DISCORD_PUBLIC_KEY=
#DISCORD_CHANNEL_ID=

# events.malenia.win calendar (optional)
#MALENIA_API_TOKEN=
#MALENIA_API_BASE=https://events.malenia.win/api

# Logging
LOG_LEVEL=INFO
#LOG_JSON=true

# Sentry (optional)
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
